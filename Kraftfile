spec: v0.6

name: llama.cpp

unikraft:
  source: lros-unikraft
  kconfig:
    CONFIG_PAGING: 'y'
    CONFIG_LIBRAMFS: 'y'
    CONFIG_LIBUKINTCTLR_GICV3: 'y'
    CONFIG_LIBPOSIX_FUTEX_WAKE_PREFER_CHILD: 'y'
    CONFIG_LIBPOSIX_PROCESS_CLONE_PREFER_CHILD: 'y'
    CONFIG_LIBUKRANDOM: 'y'
    CONFIG_LIBUKRANDOM_DEVFS: 'y'
    CONFIG_LIBUKBOOT_GRACEFUL_SHUTDOWN: 'y'
    CONFIG_LIBPOSIX_PROCESS_MULTIPROCESS: 'y'
    CONFIG_LIBUKBOOT_INIT: 'y'
    CONFIG_LIBUKFALLOC: 'y'
    CONFIG_LIBUK9P: 'y'
    CONFIG_LIBUKLIBPARAM: 'y'
    CONFIG_LIBUKVMEM: 'y'
    CONFIG_LIBPOSIX_MMAP: 'y'


targets:
- name: "bench-vacceloh"
  plat: qemu
  arch: arm64
  kconfig:
    CONFIG_LIBVACCELRT: 'y'
    CONFIG_LLAMACPP_APP_BENCH: 'y'
    CONFIG_LLAMACPP_VACCELOH: 'y'
    CONFIG_LLAMACPP_LLAMAFILE_SGEMM: 'y'
- name: "bench-vacceloh-novec"
  plat: qemu
  arch: arm64
  kconfig:
    CONFIG_LIBVACCELRT: 'y'
    CONFIG_LLAMACPP_APP_BENCH: 'y'
    CONFIG_LLAMACPP_VACCELOH: 'y'
    CONFIG_LLAMACPP_LLAMAFILE_SGEMM: 'n'
- name: "bench-vaccel"
  plat: qemu
  arch: arm64
  kconfig:
    CONFIG_LIBVACCELRT: 'y'
    CONFIG_LLAMACPP_APP_BENCH: 'y'
    CONFIG_LLAMACPP_VACCEL: 'y'
    CONFIG_LLAMACPP_LLAMAFILE_SGEMM: 'y'
- name: "bench-vaccel-novec"
  plat: qemu
  arch: arm64
  kconfig:
    CONFIG_LIBVACCELRT: 'y'
    CONFIG_LLAMACPP_APP_BENCH: 'y'
    CONFIG_LLAMACPP_VACCEL: 'y'
    CONFIG_LLAMACPP_LLAMAFILE_SGEMM: 'n'
- name: "bench-cpu"
  plat: qemu
  arch: arm64
  kconfig:
    CONFIG_LLAMACPP_APP_BENCH: 'y'
    CONFIG_LLAMACPP_VACCEL: 'n'
    CONFIG_LLAMACPP_LLAMAFILE_SGEMM: 'y'
- name: "bench-cpu-novec"
  plat: qemu
  arch: arm64
  kconfig:
    CONFIG_LLAMACPP_APP_BENCH: 'y'
    CONFIG_LLAMACPP_VACCEL: 'n'
    CONFIG_LLAMACPP_LLAMAFILE_SGEMM: 'n'
- name: "parallel"
  plat: qemu
  arch: arm64
  kconfig:
    CONFIG_LLAMACPP_APP_PARALLEL: 'y'
    CONFIG_LLAMACPP_VACCEL: 'n'
    CONFIG_LLAMACPP_LLAMAFILE_SGEMM: 'y'
- name: "server-cpu"
  plat: qemu
  arch: arm64
  kconfig:
    CONFIG_LLAMACPP_APP_SERVER: 'y'
    CONFIG_LLAMACPP_VACCEL: 'n'
    CONFIG_LLAMACPP_LLAMAFILE_SGEMM: 'y'
    CONFIG_LIBLWIP: 'y'
    CONFIG_LWIP_THREADS: 'y'
    CONFIG_LWIP_SOCKET: 'y'
    CONFIG_LIBVIRTIO_NET: 'y'
    CONFIG_LWIP_DHCP: 'y'
    CONFIG_LWIP_WAITIFACE: 'y'
    CONFIG_LWIP_WAITIFACE_TO: '5'
    CONFIG_LIBUKRANDOM_LCPU: 'n'
    CONFIG_LIBDEVFS_AUTOMOUNT: 'y'
    CONFIG_LIBVFSCORE_AUTOMOUNT_CI: 'y'
    CONFIG_LIBVFSCORE_AUTOMOUNT_CI_CUSTOM: 'y'
    CONFIG_LIBVFSCORE_AUTOMOUNT_CI0_DEV: '""'
    CONFIG_LIBVFSCORE_AUTOMOUNT_CI0_MP: '"/"'
    CONFIG_LIBVFSCORE_AUTOMOUNT_CI0_DRIVER: '"ramfs"'
    CONFIG_LIBVFSCORE_AUTOMOUNT_CI0_FLAGS: '0x0'
    CONFIG_LIBVFSCORE_AUTOMOUNT_CI0_OPTS: '""'
    CONFIG_LIBVFSCORE_AUTOMOUNT_CI0_UKOPTS_MKMP: 'y'
    CONFIG_LIBVFSCORE_AUTOMOUNT_CI1_DEV: '"rootfs"'
    CONFIG_LIBVFSCORE_AUTOMOUNT_CI1_MP: '"/root"'
    CONFIG_LIBVFSCORE_AUTOMOUNT_CI1_DRIVER: '"9pfs"'
    CONFIG_LIBVFSCORE_AUTOMOUNT_CI1_FLAGS: '0x0'
    CONFIG_LIBVFSCORE_AUTOMOUNT_CI1_OPTS: '""'
    CONFIG_LIBVFSCORE_AUTOMOUNT_CI1_UKOPTS_MKMP: 'y'
- qemu/arm64

libraries:
  libcxxabi:
    version: 0.16.0
    kconfig:
      CONFIG_LIBCXXABI_THREADS: 'y'
  libcxx:
    version: 0.16.0
    kconfig:
      CONFIG_CXX_THREADS: 'y'
  libunwind: 0.16.0
  compiler-rt:
    version: 0.18.0
    kconfig:
      CONFIG_LIBCOMPILER_RT: 'y'
  musl: 0.19.0
  lwip:
    version: 0.19.0
