menuconfig LLAMACPP_LIBGGML
	bool "llama.cpp libggml target"
	default n
	select LIBMUSL
	select LIBARM_INTRINSICS

config LLAMACPP_LLAMAFILE_SGEMM
	depends on LLAMACPP_LIBGGML
	bool "Use llamafile sgemm kernels"
	default y

config LLAMACPP_VACCEL
	depends on LLAMACPP_LIBGGML
	depends on LIBVACCELRT
	bool "Use vaccel llama backend"
	default y

menuconfig LLAMACPP_LIBLLAMA 
	bool "llama.cpp libllama target"
	default n
	select LLAMACPP_LIBGGML
	select LIBCXXABI
	select LIBCXX
	select LIBUNWIND
	select COMPILER_RT

menuconfig LLAMACPP_LIBCOMMON 
	bool "llama.cpp libcommontarget"
	default n
	select LLAMACPP_LIBLLAMA
	select LLAMACPP_LIBGGML

config LLAMACPP
	bool "llama.cpp example"
	default y
	select LLAMACPP_LIBGGML
	select LLAMACPP_LIBLLAMA
	select LLAMACPP_LIBCOMMON

choice LLAMACPP_APP
        prompt "Llama.cpp Application that runs in the unikernel"

        default LLAMACPP_APP_CLI

        config LLAMACPP_APP_CLI
                bool "CLI"

        config LLAMACPP_APP_BENCH
                bool "Bench"
endchoice

